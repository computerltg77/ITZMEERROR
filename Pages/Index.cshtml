    <!-- =========================
         MUSIC
    ========================= -->

    <audio id="backgroundMusic" loop preload="auto">
        <source src="/music/music.mp3" type="audio/mpeg" />
    </audio>

    <button
        id="musicButton"
        class="music-button"
        type="button"
        aria-label="Toggle music">
        🔊
    </button>

    <script>

        /* =========================
           ELEMENTS
        ========================= */

        const loadingScreen = document.getElementById("loadingScreen");
        const loadingProgress = document.getElementById("loadingProgress");
        const loadingPercent = document.getElementById("loadingPercent");
        const mainContent = document.getElementById("mainContent");

        const backgroundVideo = document.getElementById("backgroundVideo");

        const backgroundMusic = document.getElementById("backgroundMusic");
        const musicButton = document.getElementById("musicButton");

        const bubbleContainer = document.getElementById("bubbleContainer");
        const bubbles = document.querySelectorAll(".mouse-bubble");

        /* =========================
           MOBILE + PC VIDEO FIX
        ========================= */

        function startBackgroundVideo() {

            if (!backgroundVideo) return;

            backgroundVideo.muted = true;

            backgroundVideo.setAttribute("muted", "");
            backgroundVideo.setAttribute("playsinline", "");
            backgroundVideo.setAttribute("webkit-playsinline", "");

            const playPromise = backgroundVideo.play();

            if (playPromise !== undefined) {

                playPromise.catch(() => {
                    // Browser blocked autoplay.
                    // First touch/click will retry.
                });

            }
        }

        window.addEventListener("load", () => {
            startBackgroundVideo();
        });

        document.addEventListener(
            "touchstart",
            () => {
                startBackgroundVideo();
            },
            {
                once: true,
                passive: true
            }
        );

        document.addEventListener(
            "click",
            () => {
                startBackgroundVideo();
            },
            {
                once: true
            }
        );

        document.addEventListener("visibilitychange", () => {

            if (!document.hidden) {
                startBackgroundVideo();
            }

        });

        /* =========================
           LOADING
        ========================= */

        let progress = 0;

        const loadingInterval = setInterval(() => {

            progress++;

            loadingProgress.style.width = progress + "%";
            loadingPercent.textContent = progress + "%";

            if (progress >= 100) {

                clearInterval(loadingInterval);

                setTimeout(() => {

                    loadingScreen.classList.add("hide");
                    mainContent.classList.add("show");

                    startBackgroundVideo();

                }, 500);

            }

        }, 25);

        /* =========================
           MUSIC
        ========================= */

        let musicStarted = false;

        async function playMusic() {

            if (!backgroundMusic) return;

            try {

                backgroundMusic.volume = 0.75;

                await backgroundMusic.play();

                musicStarted = true;

                document.body.classList.add("music-playing");

                musicButton.textContent = "🔊";

            } catch (error) {

                musicStarted = false;

            }

        }

        function pauseMusic() {

            if (!backgroundMusic) return;

            backgroundMusic.pause();

            musicStarted = false;

            document.body.classList.remove("music-playing");

            musicButton.textContent = "🔇";
        }

        musicButton.addEventListener("click", async (event) => {

            event.stopPropagation();

            if (backgroundMusic.paused) {
                await playMusic();
            } else {
                pauseMusic();
            }

        });

        /*
            Browser autoplay policy:
            first user interaction starts music.
        */

        document.addEventListener(
            "click",
            () => {

                if (!musicStarted) {
                    playMusic();
                }

            },
            {
                once: true
            }
        );

        document.addEventListener(
            "touchstart",
            () => {

                if (!musicStarted) {
                    playMusic();
                }

            },
            {
                once: true,
                passive: true
            }
        );

        /* =========================
           SMOOTH MOUSE BUBBLES
        ========================= */

        let targetX = window.innerWidth / 2;
        let targetY = window.innerHeight / 2;

        let currentX = targetX;
        let currentY = targetY;

        window.addEventListener("mousemove", (event) => {

            targetX = event.clientX;
            targetY = event.clientY;

        });

        function animateBubbles() {

            currentX += (targetX - currentX) * 0.075;
            currentY += (targetY - currentY) * 0.075;

            bubbles.forEach((bubble, index) => {

                const angle =
                    (index / bubbles.length) * Math.PI * 2;

                const radius =
                    10 + (index % 7) * 7;

                const offsetX =
                    Math.cos(angle) * radius;

                const offsetY =
                    Math.sin(angle) * radius;

                const extraX =
                    Math.sin(Date.now() / 800 + index) * 4;

                const extraY =
                    Math.cos(Date.now() / 900 + index) * 4;

                bubble.style.left =
                    (currentX + offsetX + extraX) + "px";

                bubble.style.top =
                    (currentY + offsetY + extraY) + "px";

            });

            requestAnimationFrame(animateBubbles);
        }

        animateBubbles();

    </script>

</body>
</html>