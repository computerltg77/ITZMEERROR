@page
@model IndexModel
@{
    ViewData["Title"] = "ITZ ME ERROR";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ITZ ME ERROR</title>

    <style>

        /* =========================================
           RESET
        ========================================== */

        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
            color: #fff;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================================
           BACKGROUND VIDEO
        ========================================== */

        .background {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: #000;
            z-index: 0;
            border: 0 !important;
            outline: 0 !important;
        }

        .background video {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 100vh;
            min-width: 100%;
            min-height: 100%;
            object-fit: cover;
            transform: translate(-50%, -50%);
            display: block;
            border: 0 !important;
            outline: 0 !important;
        }

        .video-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.22);
            z-index: 1;
            border: 0 !important;
            outline: 0 !important;
        }


        /* =========================================
           LOADING SCREEN
        ========================================== */

        .loading-screen {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: #030305;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            z-index: 9999;

            transition:
                opacity 1s ease,
                visibility 1s ease;
        }

        .loading-screen.hide {
            opacity: 0;
            visibility: hidden;
        }

        .loading-title {
            font-size: clamp(30px, 7vw, 70px);
            font-weight: 900;
            letter-spacing: 8px;
            text-align: center;
            margin-bottom: 25px;
            color: #fff;

            text-shadow:
                0 0 5px #fff,
                0 0 12px #00d9ff,
                0 0 25px #7c3cff,
                0 0 45px #ff35d0,
                0 0 80px rgba(255, 53, 208, 0.8);

            animation:
                loadingGlow
                2s ease-in-out infinite alternate;
        }

        @@keyframes loadingGlow {

            0% {
                opacity: 0.65;

                text-shadow:
                    0 0 5px #fff,
                    0 0 12px #00d9ff,
                    0 0 25px #7c3cff,
                    0 0 40px rgba(124, 60, 255, 0.5);
            }

            50% {
                opacity: 1;

                text-shadow:
                    0 0 8px #fff,
                    0 0 18px #00d9ff,
                    0 0 35px #7c3cff,
                    0 0 60px #ff35d0;
            }

            100% {
                opacity: 0.8;

                text-shadow:
                    0 0 6px #fff,
                    0 0 15px #ff35d0,
                    0 0 35px #7c3cff,
                    0 0 75px rgba(0, 217, 255, 0.8);
            }
        }

        .loading-percent {
            font-size: 18px;
            letter-spacing: 4px;
            opacity: 0.75;
            margin-bottom: 15px;
        }

        .loading-bar {
            width: min(400px, 75vw);
            height: 5px;

            background:
                rgba(255, 255, 255, 0.18);

            border-radius: 50px;
            overflow: hidden;
            display: block;
            position: relative;
            margin-top: 2px;

            border: 0 !important;
            outline: 0 !important;
        }

        .loading-progress {
            width: 0%;
            height: 100%;

            background: #ffffff;

            border-radius: 50px;

            box-shadow:
                0 0 8px #ffffff,
                0 0 18px rgba(0, 217, 255, 0.9),
                0 0 30px rgba(124, 60, 255, 0.7);

            transition:
                width 0.08s linear;

            display: block;
        }


        /* =========================================
           MAIN
        ========================================== */

        .main {
            position: relative;
            z-index: 5;

            width: 100%;
            height: 100%;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 20px;

            opacity: 0;

            transform:
                scale(0.96);

            transition:
                opacity 1s ease,
                transform 1s ease;

            border: 0 !important;
            outline: 0 !important;
        }

        .main.show {
            opacity: 1;

            transform:
                scale(1);
        }


        /* =========================================
           PROFILE CARD
        ========================================== */

        .profile-card {
            width:
                min(500px, 94vw);

            padding:
                35px 25px;

            text-align: center;

            background:
                transparent !important;

            border: 0 !important;
            outline: 0 !important;

            box-shadow:
                none !important;

            backdrop-filter:
                none;

            -webkit-backdrop-filter:
                none;
        }


        /* =========================================
           NAME
        ========================================== */

        .name {
            font-size:
                clamp(32px, 8vw, 55px);

            font-weight: 900;

            letter-spacing:
                5px;

            margin-bottom:
                8px;

            border: 0 !important;
            outline: 0 !important;

            text-shadow:
                0 0 10px
                rgba(255, 255, 255, 0.55),

                0 0 35px
                rgba(145, 70, 255, 0.60),

                0 3px 12px
                rgba(0, 0, 0, 0.8);
        }


        /* =========================================
           USERNAME
        ========================================== */

        .username {
            color:
                rgba(255, 255, 255, 0.78);

            font-size:
                15px;

            letter-spacing:
                2px;

            margin-bottom:
                28px;

            border: 0 !important;
            outline: 0 !important;

            text-shadow:
                0 2px 8px
                rgba(0, 0, 0, 0.9);
        }


        /* =========================================
           PHOTO AREA
        ========================================== */

        .photo-area {
            position:
                relative;

            width:
                205px;

            height:
                205px;

            margin:
                0 auto 28px;

            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            border:
                0 !important;

            outline:
                0 !important;
        }


        /* =========================================
           ROTATING RING
        ========================================== */

        .rotating-ring {
            position:
                absolute;

            width:
                205px;

            height:
                205px;

            border-radius:
                50%;

            background:
                conic-gradient(
                    from 0deg,

                    #00d9ff 0deg,
                    #7c3cff 80deg,
                    #ff35d0 160deg,
                    #ff006e 230deg,
                    #7c3cff 300deg,
                    #00d9ff 360deg
                );

            z-index:
                1;

            pointer-events:
                none;

            border:
                0 !important;

            outline:
                0 !important;

            filter:
                drop-shadow(
                    0 0 8px
                    rgba(0, 217, 255, 0.70)
                )

                drop-shadow(
                    0 0 16px
                    rgba(255, 53, 208, 0.50)
                );

            animation:
                none;
        }


        /* =========================================
           CUT CENTER FROM RING
        ========================================== */

        .rotating-ring::before {
            content:
                "";

            position:
                absolute;

            inset:
                6px;

            border-radius:
                50%;

            background:
                rgba(0, 0, 0, 0.01);

            border:
                0 !important;

            outline:
                0 !important;

            pointer-events:
                none;
        }


        /* =========================================
           MUSIC PLAYING = RING ROTATES
        ========================================== */

        .music-playing .rotating-ring {
            animation:
                rotateRing
                3s linear infinite;
        }

        @@keyframes rotateRing {

            from {
                transform:
                    rotate(0deg);
            }

            to {
                transform:
                    rotate(360deg);
            }
        }


        /* =========================================
           PROFILE PHOTO
        ========================================== */

        .profile-photo {
            width:
                175px;

            height:
                175px;

            border-radius:
                50%;

            overflow:
                hidden;

            position:
                relative;

            z-index:
                2;

            background:
                rgba(0, 0, 0, 0.10);

            border:
                1px solid
                rgba(255, 255, 255, 0.10);

            outline:
                none !important;

            box-shadow:
                0 0 12px
                rgba(140, 70, 255, 0.22);
        }

        .profile-photo img {
            width:
                100%;

            height:
                100%;

            display:
                block;

            object-fit:
                cover;

            object-position:
                center;

            border:
                0 !important;

            outline:
                0 !important;
        }


        /* =========================================
           CONTACT ME
        ========================================== */

        .contact-title {
            text-align:
                center;

            font-size:
                14px;

            font-weight:
                900;

            letter-spacing:
                5px;

            color:
                #fff;

            margin-top:
                0;

            margin-bottom:
                12px;

            text-shadow:
                0 0 6px #fff,
                0 0 14px #00d9ff,
                0 0 28px #7c3cff,
                0 0 40px rgba(255, 53, 208, 0.65);

            animation:
                contactGlow
                2.2s ease-in-out infinite alternate;
        }

        @@keyframes contactGlow {

            from {
                opacity: 0.72;

                text-shadow:
                    0 0 5px #fff,
                    0 0 12px #00d9ff,
                    0 0 22px #7c3cff;
            }

            to {
                opacity: 1;

                text-shadow:
                    0 0 7px #fff,
                    0 0 17px #00d9ff,
                    0 0 30px #7c3cff,
                    0 0 42px rgba(255, 53, 208, 0.7);
            }
        }


        /* =========================================
           SOCIAL BUTTONS
        ========================================== */

        .socials {
            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            gap:
                10px;

            flex-wrap:
                nowrap;

            margin-top:
                0;

            border:
                0 !important;

            outline:
                0 !important;
        }

        .social-btn {
            flex:
                1;

            min-width:
                0;

            max-width:
                145px;

            height:
                48px;

            padding:
                0 12px;

            border-radius:
                14px;

            border:
                1px solid
                rgba(255, 255, 255, 0.14);

            background:
                rgba(255, 255, 255, 0.055);

            color:
                white;

            text-decoration:
                none;

            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            gap:
                8px;

            font-size:
                13px;

            font-weight:
                700;

            letter-spacing:
                0.5px;

            transition:
                all 0.25s ease;
        }

        .social-btn:hover {
            transform:
                translateY(-4px);

            background:
                rgba(255, 255, 255, 0.13);

            border-color:
                rgba(255, 255, 255, 0.25);

            box-shadow:
                0 10px 25px
                rgba(0, 0, 0, 0.35);
        }


        /* =========================================
           SOCIAL ICONS
        ========================================== */

        .social-icon {
            width:
                19px;

            height:
                19px;

            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            flex-shrink:
                0;
        }


        /* DISCORD */

        .discord-icon {
            width:
                20px;

            height:
                15px;

            background:
                white;

            border-radius:
                7px 7px 5px 5px;

            position:
                relative;
        }

        .discord-icon::before {
            content:
                "";

            position:
                absolute;

            width:
                5px;

            height:
                5px;

            background:
                #000;

            border-radius:
                50%;

            left:
                4px;

            top:
                5px;

            box-shadow:
                7px 0 0 #000;
        }

        .discord-icon::after {
            content:
                "";

            position:
                absolute;

            width:
                6px;

            height:
                3px;

            border-radius:
                0 0 7px 7px;

            border-bottom:
                2px solid #000;

            left:
                7px;

            bottom:
                1px;
        }


        /* INSTAGRAM */

        .instagram-icon {
            width:
                19px;

            height:
                19px;

            border:
                2px solid white;

            border-radius:
                5px;

            position:
                relative;
        }

        .instagram-icon::before {
            content:
                "";

            position:
                absolute;

            width:
                7px;

            height:
                7px;

            border:
                2px solid white;

            border-radius:
                50%;

            top:
                4px;

            left:
                4px;
        }

        .instagram-icon::after {
            content:
                "";

            position:
                absolute;

            width:
                3px;

            height:
                3px;

            background:
                white;

            border-radius:
                50%;

            right:
                2px;

            top:
                2px;
        }


        /* FACEBOOK */

        .facebook-icon {
            font-size:
                20px;

            font-weight:
                900;

            line-height:
                1;

            font-family:
                Arial,
                sans-serif;
        }


        /* =========================================
           FOOTER
        ========================================== */

        .footer {
            margin-top:
                25px;

            font-size:
                11px;

            color:
                rgba(255, 255, 255, 0.45);

            letter-spacing:
                2px;

            border:
                0 !important;

            outline:
                0 !important;

            text-shadow:
                0 2px 6px
                rgba(0, 0, 0, 0.8);
        }


        /* =========================================
           MUSIC BUTTON
        ========================================== */

        .music-btn {
            position:
                fixed;

            right:
                22px;

            bottom:
                22px;

            width:
                52px;

            height:
                52px;

            border-radius:
                50%;

            border:
                1px solid
                rgba(255, 255, 255, 0.18);

            background:
                rgba(0, 0, 0, 0.20);

            color:
                white;

            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            font-size:
                20px;

            cursor:
                pointer;

            z-index:
                100;

            backdrop-filter:
                blur(5px);

            transition:
                0.25s ease;
        }

        .music-btn:hover {
            transform:
                scale(1.08);

            box-shadow:
                0 0 25px
                rgba(155, 92, 255, 0.5);
        }

        .music-btn.playing {
            box-shadow:
                0 0 25px
                rgba(155, 92, 255, 0.75);
        }


        /* =========================================
           ONLINE STATUS
        ========================================== */

        .online-status {
            position:
                fixed;

            top:
                18px;

            right:
                20px;

            display:
                flex;

            align-items:
                center;

            gap:
                7px;

            padding:
                6px 10px;

            background:
                rgba(0, 0, 0, 0.30);

            border:
                1px solid
                rgba(255, 255, 255, 0.12);

            border-radius:
                20px;

            color:
                #fff;

            font-size:
                11px;

            font-weight:
                800;

            letter-spacing:
                2px;

            z-index:
                200;

            backdrop-filter:
                blur(6px);

            -webkit-backdrop-filter:
                blur(6px);

            box-shadow:
                0 0 12px
                rgba(255, 0, 0, 0.12);
        }

        .online-dot {
            width:
                7px;

            height:
                7px;

            border-radius:
                50%;

            background:
                #ff1a1a;

            animation:
                onlineBlink
                1.1s ease-in-out infinite;
        }

        @@keyframes onlineBlink {

            0%,
            100% {

                opacity:
                    1;

                transform:
                    scale(1);

                box-shadow:
                    0 0 5px #ff1a1a,
                    0 0 12px #ff0000;
            }

            50% {

                opacity:
                    0.20;

                transform:
                    scale(0.75);

                box-shadow:
                    0 0 2px #ff1a1a;
            }
        }


        /* =========================================
           SMOOTH MULTI MOUSE BUBBLES
        ========================================== */

        .bubble-container {
            position:
                fixed;

            inset:
                0;

            pointer-events:
                none;

            z-index:
                4;

            overflow:
                hidden;
        }

        .mouse-bubble {
            position:
                absolute;

            left:
                0;

            top:
                0;

            width:
                var(--size);

            height:
                var(--size);

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle at 30% 25%,
                    rgba(255, 255, 255, 0.98) 0%,
                    rgba(255, 255, 255, 0.55) 8%,
                    rgba(0, 217, 255, 0.52) 24%,
                    rgba(124, 60, 255, 0.38) 48%,
                    rgba(255, 53, 208, 0.20) 67%,
                    transparent 78%
                );

            border:
                1px solid
                rgba(255, 255, 255, 0.28);

            box-shadow:
                0 0 7px
                rgba(0, 217, 255, 0.70),

                0 0 16px
                rgba(124, 60, 255, 0.55),

                0 0 28px
                rgba(255, 53, 208, 0.38),

                inset 0 0 9px
                rgba(255, 255, 255, 0.25);

            opacity:
                0;

            transform:
                translate3d(-50%, -50%, 0)
                scale(0.35);

            will-change:
                transform,
                left,
                top,
                opacity;

            transition:
                left 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
                top 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
                opacity 0.7s ease;

            animation:
                bubbleFloat
                var(--duration)
                ease-in-out
                infinite;

            animation-delay:
                var(--delay);
        }

        .bubble-container.active .mouse-bubble {
            opacity:
                var(--opacity);
        }

        @@keyframes bubbleFloat {

            0% {
                transform:
                    translate3d(-50%, -50%, 0)
                    scale(0.40);
            }

            20% {
                transform:
                    translate3d(
                        calc(-50% + var(--x1)),
                        calc(-50% + var(--y1)),
                        0
                    )
                    scale(0.90);
            }

            40% {
                transform:
                    translate3d(
                        calc(-50% + var(--x2)),
                        calc(-50% + var(--y2)),
                        0
                    )
                    scale(0.68);
            }

            60% {
                transform:
                    translate3d(
                        calc(-50% + var(--x3)),
                        calc(-50% + var(--y3)),
                        0
                    )
                    scale(1.12);
            }

            80% {
                transform:
                    translate3d(
                        calc(-50% + var(--x4)),
                        calc(-50% + var(--y4)),
                        0
                    )
                    scale(0.78);
            }

            100% {
                transform:
                    translate3d(
                        calc(-50% + var(--x5)),
                        calc(-50% + var(--y5)),
                        0
                    )
                    scale(0.35);
            }
        }


        /* =========================================
           MOBILE
        ========================================== */

        @@media (max-width: 600px) {

            .profile-card {
                padding:
                    28px 15px;

                background:
                    transparent !important;

                border:
                    0 !important;

                box-shadow:
                    none !important;
            }

            .name {
                font-size:
                    32px;

                letter-spacing:
                    3px;
            }

            .username {
                margin-bottom:
                    22px;
            }

            .photo-area {
                width:
                    180px;

                height:
                    180px;
            }

            .rotating-ring {
                width:
                    180px;

                height:
                    180px;
            }

            .profile-photo {
                width:
                    154px;

                height:
                    154px;

                border:
                    1px solid
                    rgba(255, 255, 255, 0.10);
            }

            .contact-title {
                font-size:
                    12px;

                letter-spacing:
                    4px;

                margin-bottom:
                    10px;
            }

            .socials {
                gap:
                    7px;
            }

            .social-btn {
                height:
                    44px;

                padding:
                    0 7px;

                font-size:
                    11px;

                border-radius:
                    12px;
            }

            .social-icon {
                width:
                    17px;

                height:
                    17px;
            }

            .discord-icon {
                width:
                    18px;

                height:
                    14px;
            }

            .instagram-icon {
                width:
                    17px;

                height:
                    17px;
            }

            .facebook-icon {
                font-size:
                    18px;
            }

            .music-btn {
                width:
                    48px;

                height:
                    48px;

                right:
                    15px;

                bottom:
                    15px;
            }

            .online-status {
                top:
                    12px;

                right:
                    12px;

                padding:
                    5px 8px;

                font-size:
                    9px;

                gap:
                    6px;

                letter-spacing:
                    1.5px;
            }

            .online-dot {
                width:
                    6px;

                height:
                    6px;
            }

            .bubble-container {
                display:
                    none;
            }
        }

    </style>
</head>


<body>


    <!-- =========================================
         ONLINE STATUS
    ========================================== -->

    <div class="online-status">

        <span class="online-dot"></span>

        <span>
            ONLINE
        </span>

    </div>


    <!-- =========================================
         SMOOTH MULTI BUBBLES
    ========================================== -->

    <div
        class="bubble-container"
        id="bubbleContainer">

        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>
        <div class="mouse-bubble"></div>

    </div>


    <!-- =========================================
         BACKGROUND VIDEO
    ========================================== -->

    <div class="background">

        <video
            autoplay
            muted
            loop
            playsinline>

            <source
                src="/video/background.mp4"
                type="video/mp4">

        </video>

        <div class="video-overlay"></div>

    </div>


    <!-- =========================================
         MUSIC
    ========================================== -->

    <audio
        id="backgroundMusic"
        loop>

        <source
            src="/music/music.mp3"
