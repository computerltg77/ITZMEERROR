         MUSIC BUTTON
    ========================================== -->

    <button
        class="music-btn"
        id="musicButton"
        type="button">

        🔇

    </button>


    <!-- =========================================
         JAVASCRIPT
    ========================================== -->

    <script>


        /* =========================================
           LOADING
        ========================================== */

        let percent = 0;

        const loadingPercent =
            document.getElementById(
                "loadingPercent"
            );

        const loadingProgress =
            document.getElementById(
                "loadingProgress"
            );

        const loadingScreen =
            document.getElementById(
                "loadingScreen"
            );

        const main =
            document.getElementById(
                "main"
            );


        const loadingTimer =
            setInterval(() => {

                percent++;

                loadingPercent.textContent =
                    percent + "%";

                loadingProgress.style.width =
                    percent + "%";


                if (percent >= 100) {

                    clearInterval(
                        loadingTimer
                    );


                    setTimeout(() => {

                        loadingScreen.classList.add(
                            "hide"
                        );

                        main.classList.add(
                            "show"
                        );

                    }, 500);

                }

            }, 25);


        /* =========================================
           MUSIC
        ========================================== */

        const music =
            document.getElementById(
                "backgroundMusic"
            );

        const musicButton =
            document.getElementById(
                "musicButton"
            );

        let musicStarted = false;


        function playMusic() {

            music.play()
                .then(() => {

                    musicStarted = true;

                    musicButton.textContent =
                        "🔊";

                    musicButton.classList.add(
                        "playing"
                    );

                    document.body.classList.add(
                        "music-playing"
                    );

                })
                .catch(() => {

                    console.log(
                        "Music requires user interaction."
                    );

                });

        }


        function stopMusic() {

            music.pause();

            musicButton.textContent =
                "🔇";

            musicButton.classList.remove(
                "playing"
            );

            document.body.classList.remove(
                "music-playing"
            );

        }


        musicButton.addEventListener(
            "click",
            (event) => {

                event.stopPropagation();

                if (music.paused) {

                    playMusic();

                }
                else {

                    stopMusic();

                }

            }
        );


        /* =========================================
           FIRST USER CLICK
        ========================================== */

        document.addEventListener(
            "click",
            () => {

                if (!musicStarted) {

                    playMusic();

                }

            },
            {
                once: true
            }
        );


        /* =========================================
           MUSIC ENDED
        ========================================== */

        music.addEventListener(
            "ended",
            () => {

                musicButton.textContent =
                    "🔇";

                musicButton.classList.remove(
                    "playing"
                );

                document.body.classList.remove(
                    "music-playing"
                );

            }
        );


        /* =========================================
           SMOOTH MULTI MOUSE BUBBLES
        ========================================== */

        const bubbleContainer =
            document.getElementById(
                "bubbleContainer"
            );

        const bubbles =
            document.querySelectorAll(
                ".mouse-bubble"
            );


        /* RANDOMIZE BUBBLES */

        bubbles.forEach(
            (bubble) => {

                const size =
                    6 + Math.random() * 24;

                const duration =
                    3.2 + Math.random() * 3.5;

                const opacity =
                    0.38 + Math.random() * 0.52;


                bubble.style.setProperty(
                    "--size",
                    size + "px"
                );

                bubble.style.setProperty(
                    "--duration",
                    duration + "s"
                );

                bubble.style.setProperty(
                    "--opacity",
                    opacity.toFixed(2)
                );


                bubble.style.setProperty(
                    "--x1",
                    (-60 + Math.random() * 120) + "px"
                );

                bubble.style.setProperty(
                    "--y1",
                    (-60 + Math.random() * 120) + "px"
                );


                bubble.style.setProperty(
                    "--x2",
                    (-120 + Math.random() * 240) + "px"
                );

                bubble.style.setProperty(
                    "--y2",
                    (-120 + Math.random() * 240) + "px"
                );


                bubble.style.setProperty(
                    "--x3",
                    (-170 + Math.random() * 340) + "px"
                );

                bubble.style.setProperty(
                    "--y3",
                    (-170 + Math.random() * 340) + "px"
                );


                bubble.style.setProperty(
                    "--x4",
                    (-140 + Math.random() * 280) + "px"
                );

                bubble.style.setProperty(
                    "--y4",
                    (-190 + Math.random() * 380) + "px"
                );


                bubble.style.setProperty(
                    "--x5",
                    (-80 + Math.random() * 160) + "px"
                );

                bubble.style.setProperty(
                    "--y5",
                    (-220 + Math.random() * 440) + "px"
                );


                bubble.style.setProperty(
                    "--delay",
                    (-Math.random() * duration) + "s"
                );

            }
        );


        /* =========================================
           SMOOTH MOUSE FOLLOW
        ========================================== */

        let targetX = 0;
        let targetY = 0;

        let currentX = 0;
        let currentY = 0;

        let mouseActive = false;


        document.addEventListener(
            "mousemove",
            (event) => {

                targetX =
                    event.clientX;

                targetY =
                    event.clientY;

                mouseActive = true;

                bubbleContainer.classList.add(
                    "active"
                );

            }
        );


        /* =========================================
           SMOOTH ANIMATION LOOP
        ========================================== */

        function animateBubbles() {

            currentX +=
                (targetX - currentX) * 0.075;

            currentY +=
                (targetY - currentY) * 0.075;


            bubbles.forEach(
                (bubble, index) => {

                    const angle =
                        (index / bubbles.length)
                        * Math.PI * 2;

                    const radius =
                        15 +
                        (index % 6) * 8;

                    const wave =
                        Math.sin(
                            performance.now() / 900
                            + index
                        ) * 10;

                    const offsetX =
                        Math.cos(angle)
                        * radius
                        + wave;

                    const offsetY =
                        Math.sin(angle)
                        * radius
                        + Math.cos(
                            performance.now() / 1100
                            + index
                        ) * 8;


                    bubble.style.left =
                        (
                            currentX
                            + offsetX
                        ) + "px";


                    bubble.style.top =
                        (
                            currentY
                            + offsetY
                        ) + "px";

                }
            );


            requestAnimationFrame(
                animateBubbles
            );

        }


        animateBubbles();


        /* =========================================
           MOUSE LEAVE
        ========================================== */

        document.addEventListener(
            "mouseleave",
            () => {

                mouseActive = false;

                bubbleContainer.classList.remove(
                    "active"
                );

            }
        );


    </script>

</body>
