@page
@model IndexModel
@{
    ViewData["Title"] = "ITZ ME ERROR";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ITZ ME ERROR</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: Arial, Helvetica, sans-serif;
            background: #000;
        }

        body {
            color: #fff;
        }

        /* =========================
           BACKGROUND VIDEO
        ========================= */

        .background {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
            z-index: 0;
        }

        .background-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            background: #000;
        }

        .background-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.22);
            z-index: 1;
            pointer-events: none;
        }

        /* =========================
           LOADING SCREEN
        ========================= */

        .loading-screen {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #000;
            z-index: 9999;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        .loading-screen.hide {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .loading-title {
            font-size: clamp(30px, 7vw, 70px);
            font-weight: 900;
            letter-spacing: 8px;
            text-align: center;
            margin-bottom: 25px;
            color: #fff;
            text-shadow:
                0 0 5px #fff,
                0 0 12px #00d9ff,
                0 0 25px #7c3cff,
                0 0 45px #ff35d0,
                0 0 80px rgba(255, 53, 208, 0.8);
            animation: loadingGlow 2s ease-in-out infinite alternate;
        }

        @@keyframes loadingGlow {
            0% {
                opacity: 0.65;
                text-shadow:
                    0 0 5px #fff,
                    0 0 12px #00d9ff,
                    0 0 25px #7c3cff;
            }

            50% {
                opacity: 1;
                text-shadow:
                    0 0 7px #fff,
                    0 0 18px #00d9ff,
                    0 0 35px #7c3cff,
                    0 0 55px #ff35d0;
            }

            100% {
                opacity: 0.8;
                text-shadow:
                    0 0 5px #fff,
                    0 0 15px #00d9ff,
                    0 0 30px #7c3cff,
                    0 0 50px #ff35d0;
            }
        }

        .loading-percent {
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 3px;
            margin-bottom: 10px;
            color: #fff;
            text-shadow:
                0 0 8px #00d9ff,
                0 0 18px #7c3cff;
        }

        .loading-bar {
            width: min(400px, 75vw);
            height: 5px;
            background: rgba(255, 255, 255, 0.18);
            border-radius: 50px;
            overflow: hidden;
            display: block;
            position: relative;
            margin-top: 2px;
            border: 0 !important;
            outline: 0 !important;
        }

        .loading-progress {
            width: 0%;
            height: 100%;
            background: #fff;
            border-radius: 50px;
            box-shadow:
                0 0 8px #fff,
                0 0 18px rgba(0, 217, 255, 0.9),
                0 0 30px rgba(124, 60, 255, 0.7);
            transition: width 0.08s linear;
            display: block;
        }

        /* =========================
           MAIN
        ========================= */

        .main {
            position: relative;
            z-index: 2;
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: scale(0.96);
            transition: opacity 0.8s ease, transform 0.8s ease;
            overflow: hidden;
        }

        .main.show {
            opacity: 1;
            transform: scale(1);
        }

        .profile-card {
            width: min(500px, 94vw);
            padding: 35px 25px;
            text-align: center;
            background: transparent !important;
            border: 0 !important;
            outline: 0 !important;
            box-shadow: none !important;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            position: relative;
            z-index: 10;
        }

        /* =========================
           NAME
        ========================= */

        .name {
            font-size: clamp(32px, 8vw, 55px);
            font-weight: 900;
            letter-spacing: 5px;
            margin-bottom: 8px;
            border: 0 !important;
            outline: 0 !important;
            text-shadow:
                0 0 10px rgba(255, 255, 255, 0.55),
                0 0 35px rgba(145, 70, 255, 0.60),
                0 3px 12px rgba(0, 0, 0, 0.8);
        }

        .username {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.82);
            margin-bottom: 25px;
            text-shadow:
                0 0 8px rgba(0, 217, 255, 0.65),
                0 0 15px rgba(124, 60, 255, 0.55);
        }

        /* =========================
           PROFILE PHOTO + RING
        ========================= */

        .photo-area {
            width: 205px;
            height: 205px;
            margin: 0 auto 25px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .rotating-ring {
            position: absolute;
            width: 205px;
            height: 205px;
            border-radius: 50%;
            background:
                conic-gradient(
                    from 0deg,
                    #00d9ff 0deg,
                    #7c3cff 80deg,
                    #ff35d0 160deg,
                    #ff006e 230deg,
                    #7c3cff 300deg,
                    #00d9ff 360deg
                );
            z-index: 1;
            pointer-events: none;
            border: 0 !important;
            outline: 0 !important;
            filter:
                drop-shadow(0 0 8px rgba(0, 217, 255, 0.70))
                drop-shadow(0 0 16px rgba(255, 53, 208, 0.50));
            animation: none;
        }

        .rotating-ring::before {
            content: "";
            position: absolute;
            inset: 6px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.01);
            border: 0 !important;
            outline: 0 !important;
            pointer-events: none;
        }

        .music-playing .rotating-ring {
            animation: rotateRing 3s linear infinite;
        }

        @@keyframes rotateRing {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .profile-photo {
            width: 175px;
            height: 175px;
            border-radius: 50%;
            overflow: hidden;
            position: relative;
            z-index: 2;
            background: rgba(0, 0, 0, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.10);
            outline: none !important;
            box-shadow: 0 0 12px rgba(140, 70, 255, 0.22);
        }

        .profile-photo img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center;
        }

        /* =========================
           CONTACT
        ========================= */

        .contact-title {
            text-align: center;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 5px;
            color: #fff;
            margin-top: 0;
            margin-bottom: 12px;
            text-shadow:
                0 0 6px #fff,
                0 0 14px #00d9ff,
                0 0 28px #7c3cff,
                0 0 40px rgba(255, 53, 208, 0.65);
            animation: contactGlow 2.2s ease-in-out infinite alternate;
        }

        @@keyframes contactGlow {
            from {
                opacity: 0.72;
                text-shadow:
                    0 0 5px #fff,
                    0 0 12px #00d9ff,
                    0 0 22px #7c3cff;
            }

            to {
                opacity: 1;
                text-shadow:
                    0 0 7px #fff,
                    0 0 17px #00d9ff,
                    0 0 30px #7c3cff,
                    0 0 42px rgba(255, 53, 208, 0.7);
            }
        }

        /* =========================
           SOCIAL BUTTONS
        ========================= */

        .socials {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            width: 100%;
        }

        .social-btn {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #fff;
            background: rgba(0, 0, 0, 0.30);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow:
                0 0 10px rgba(0, 217, 255, 0.15),
                inset 0 0 15px rgba(124, 60, 255, 0.08);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                background 0.25s ease;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
        }

        .social-btn:hover {
            transform: translateY(-5px) scale(1.08);
            background: rgba(0, 0, 0, 0.45);
            box-shadow:
                0 0 15px rgba(0, 217, 255, 0.55),
                0 0 30px rgba(124, 60, 255, 0.35);
        }

        /* Discord icon */

        .discord-icon {
            width: 26px;
            height: 19px;
            position: relative;
            background: #fff;
            border-radius: 7px 7px 9px 9px;
        }

        .discord-icon::before {
            content: "";
            position: absolute;
            width: 7px;
            height: 7px;
            background: #000;
            border-radius: 50%;
            left: 5px;
            top: 6px;
            box-shadow: 10px 0 0 #000;
        }

        .discord-icon::after {
            content: "";
            position: absolute;
            width: 8px;
            height: 4px;
            border-radius: 0 0 8px 8px;
            background: #fff;
            left: 9px;
            bottom: -2px;
        }

        /* Instagram icon */

        .instagram-icon {
            width: 25px;
            height: 25px;
            border: 3px solid #fff;
            border-radius: 8px;
            position: relative;
        }

        .instagram-icon::before {
            content: "";
            position: absolute;
            width: 9px;
            height: 9px;
            border: 2px solid #fff;
            border-radius: 50%;
            top: 5px;
            left: 5px;
        }

        .instagram-icon::after {
            content: "";
            position: absolute;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #fff;
            top: 3px;
            right: 3px;
        }

        /* Facebook icon */

        .facebook-icon {
            font-size: 31px;
            font-weight: 900;
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1;
            transform: translateY(2px);
        }

        /* =========================
           FOOTER
        ========================= */

        .footer-text {
            margin-top: 22px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 4px;
            color: rgba(255, 255, 255, 0.62);
            text-shadow:
                0 0 8px rgba(124, 60, 255, 0.65);
        }

        /* =========================
           ONLINE STATUS
        ========================= */

        .online-status {
            position: fixed;
            top: 18px;
            right: 20px;
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 6px 10px;
            background: rgba(0, 0, 0, 0.30);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 20px;
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            z-index: 200;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            box-shadow: 0 0 12px rgba(255, 0, 0, 0.12);
        }

        .online-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ff1a1a;
            animation: onlineBlink 1.1s ease-in-out infinite;
        }

        @@keyframes onlineBlink {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
                box-shadow:
                    0 0 5px #ff1a1a,
                    0 0 12px #ff0000;
            }

            50% {
                opacity: 0.20;
                transform: scale(0.75);
                box-shadow: 0 0 2px #ff1a1a;
            }
        }

        /* =========================
           MUSIC BUTTON
        ========================= */

        .music-button {
            position: fixed;
            right: 22px;
            bottom: 22px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.18);
            background: rgba(0, 0, 0, 0.38);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 300;
            font-size: 20px;
            box-shadow:
                0 0 12px rgba(0, 217, 255, 0.28),
                0 0 25px rgba(124, 60, 255, 0.18);
            backdrop-filter: blur(7px);
            -webkit-backdrop-filter: blur(7px);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .music-button:hover {
            transform: scale(1.08);
            box-shadow:
                0 0 18px rgba(0, 217, 255, 0.55),
                0 0 35px rgba(124, 60, 255, 0.30);
        }

        /* =========================
           MOUSE BUBBLES
        ========================= */

        .bubble-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 4;
            overflow: hidden;
        }

        .mouse-bubble {
            position: absolute;
            left: 0;
            top: 0;
            width: var(--size);
            height: var(--size);
            margin-left: calc(var(--size) / -2);
            margin-top: calc(var(--size) / -2);
            border-radius: 50%;
            background:
                radial-gradient(
                    circle at 30% 30%,
                    rgba(255,255,255,0.95) 0%,
                    rgba(0,217,255,0.55) 12%,
                    rgba(124,60,255,0.30) 38%,
                    rgba(255,53,208,0.15) 58%,
                    rgba(255,53,208,0) 75%
                );
            border: 1px solid rgba(255,255,255,0.25);
            box-shadow:
                0 0 8px rgba(0,217,255,0.55),
                0 0 18px rgba(124,60,255,0.35),
                0 0 28px rgba(255,53,208,0.22);
            opacity: var(--opacity);
            filter: blur(var(--blur));
            will-change: transform, left, top;
            animation: bubbleFloat var(--float-time) ease-in-out infinite alternate;
        }

        @@keyframes bubbleFloat {
            from {
                transform: translate3d(
                    calc(var(--drift-x) * -1),
                    calc(var(--drift-y) * -1),
                    0
                ) scale(0.92);
            }

            to {
                transform: translate3d(
                    var(--drift-x),
                    var(--drift-y),
                    0
                ) scale(1.08);
            }
        }

        /* =========================
           MOBILE
        ========================= */

        @@media (max-width: 600px) {

            .profile-card {
                width: 94vw;
                padding: 25px 15px;
            }

            .name {
                font-size: clamp(28px, 9vw, 42px);
                letter-spacing: 3px;
            }

            .username {
                font-size: 13px;
                margin-bottom: 20px;
            }

            .photo-area {
                width: 180px;
                height: 180px;
                margin-bottom: 22px;
            }

            .rotating-ring {
                width: 180px;
                height: 180px;
            }

            .profile-photo {
                width: 154px;
                height: 154px;
                border: 1px solid rgba(255,255,255,0.10);
            }

            .contact-title {
                font-size: 12px;
                letter-spacing: 4px;
            }

            .socials {
                gap: 9px;
            }

            .social-btn {
                width: 52px;
                height: 52px;
            }

            .online-status {
                top: 12px;
                right: 12px;
                font-size: 9px;
                padding: 5px 8px;
            }

            .music-button {
                width: 48px;
                height: 48px;
                right: 16px;
                bottom: 16px;
            }

            .footer-text {
                font-size: 8px;
                letter-spacing: 3px;
                margin-top: 18px;
            }

            .bubble-container {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         BACKGROUND
    ========================= -->

    <div class="background">
        <video
            id="backgroundVideo"
            class="background-video"
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline
            preload="auto">
            <source src="/video/background.mp4" type="video/mp4" />
        </video>

        <div class="background-overlay"></div>
    </div>

    <!-- =========================
         LOADING
    ========================= -->

    <div id="loadingScreen" class="loading-screen">

        <div class="loading-title">
            ITZ ME ERROR
        </div>

        <div id="loadingPercent" class="loading-percent">
            0%
        </div>

        <div class="loading-bar">
            <div id="loadingProgress" class="loading-progress"></div>
        </div>

    </div>

    <!-- =========================
         MOUSE BUBBLES
    ========================= -->

    <div class="bubble-container" id="bubbleContainer">

        <div class="mouse-bubble" style="--size:18px;--opacity:.55;--blur:0px;--float-time:3.2s;--drift-x:7px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:12px;--opacity:.45;--blur:0px;--float-time:2.7s;--drift-x:5px;--drift-y:8px;"></div>
        <div class="mouse-bubble" style="--size:22px;--opacity:.38;--blur:1px;--float-time:4.1s;--drift-x:8px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:10px;--opacity:.65;--blur:0px;--float-time:2.4s;--drift-x:6px;--drift-y:4px;"></div>
        <div class="mouse-bubble" style="--size:15px;--opacity:.50;--blur:0px;--float-time:3.5s;--drift-x:9px;--drift-y:7px;"></div>
        <div class="mouse-bubble" style="--size:25px;--opacity:.30;--blur:1px;--float-time:4.5s;--drift-x:7px;--drift-y:9px;"></div>
        <div class="mouse-bubble" style="--size:13px;--opacity:.60;--blur:0px;--float-time:2.9s;--drift-x:5px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:19px;--opacity:.42;--blur:0px;--float-time:3.8s;--drift-x:8px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:11px;--opacity:.58;--blur:0px;--float-time:2.6s;--drift-x:6px;--drift-y:7px;"></div>
        <div class="mouse-bubble" style="--size:17px;--opacity:.48;--blur:0px;--float-time:3.4s;--drift-x:9px;--drift-y:5px;"></div>

        <div class="mouse-bubble" style="--size:14px;--opacity:.55;--blur:0px;--float-time:3.1s;--drift-x:7px;--drift-y:8px;"></div>
        <div class="mouse-bubble" style="--size:24px;--opacity:.32;--blur:1px;--float-time:4.3s;--drift-x:6px;--drift-y:9px;"></div>
        <div class="mouse-bubble" style="--size:9px;--opacity:.65;--blur:0px;--float-time:2.2s;--drift-x:5px;--drift-y:4px;"></div>
        <div class="mouse-bubble" style="--size:20px;--opacity:.40;--blur:0px;--float-time:3.9s;--drift-x:8px;--drift-y:7px;"></div>
        <div class="mouse-bubble" style="--size:16px;--opacity:.52;--blur:0px;--float-time:3.0s;--drift-x:7px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:27px;--opacity:.28;--blur:1px;--float-time:4.8s;--drift-x:9px;--drift-y:8px;"></div>
        <div class="mouse-bubble" style="--size:12px;--opacity:.62;--blur:0px;--float-time:2.5s;--drift-x:5px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:18px;--opacity:.45;--blur:0px;--float-time:3.7s;--drift-x:8px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:10px;--opacity:.60;--blur:0px;--float-time:2.8s;--drift-x:6px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:21px;--opacity:.36;--blur:1px;--float-time:4.0s;--drift-x:7px;--drift-y:9px;"></div>

        <div class="mouse-bubble" style="--size:13px;--opacity:.58;--blur:0px;--float-time:2.7s;--drift-x:6px;--drift-y:7px;"></div>
        <div class="mouse-bubble" style="--size:23px;--opacity:.34;--blur:1px;--float-time:4.4s;--drift-x:9px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:11px;--opacity:.64;--blur:0px;--float-time:2.3s;--drift-x:5px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:19px;--opacity:.43;--blur:0px;--float-time:3.6s;--drift-x:8px;--drift-y:8px;"></div>
        <div class="mouse-bubble" style="--size:15px;--opacity:.51;--blur:0px;--float-time:3.3s;--drift-x:7px;--drift-y:6px;"></div>
        <div class="mouse-bubble" style="--size:26px;--opacity:.29;--blur:1px;--float-time:4.6s;--drift-x:9px;--drift-y:9px;"></div>
        <div class="mouse-bubble" style="--size:12px;--opacity:.61;--blur:0px;--float-time:2.9s;--drift-x:6px;--drift-y:5px;"></div>
        <div class="mouse-bubble" style="--size:17px;--opacity:.47;--blur:0px;--float-time:3.8s;--drift-x:8px;--drift-y:7px;"></div>
        <div class="mouse-bubble" style="--size:9px;--opacity:.67;--blur:0px;--float-time:2.1s;--drift-x:5px;--drift-y:4px;"></div>
        <div class="mouse-bubble" style="--size:22px;--opacity:.35;--blur:1px;--float-time:4.2s;--drift-x:7px;--drift-y:8px;"></div>
    </div>

    <!-- =========================
         ONLINE
    ========================= -->

    <div class="online-status">
        <span class="online-dot"></span>
        ONLINE
    </div>

    <!-- =========================
         MAIN PROFILE
    ========================= -->

    <main id="mainContent" class="main">

        <div class="profile-card">

            <div class="name">
                ITZ ME ERROR
            </div>

            <div class="username">
                @@errorx500
            </div>

            <div class="photo-area">

                <div class="rotating-ring"></div>

                <div class="profile-photo">
                    <img
                        src="/images/profile.jpg.jpeg"
                        alt="ITZ ME ERROR" />
                </div>

            </div>

            <div class="contact-title">
                CONTACT ME
            </div>

            <div class="socials">

                <a
                    class="social-btn"
                    href="https://discord.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Discord">

